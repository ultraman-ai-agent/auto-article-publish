# ===== 内容生成后端：openai 或 anthropic =====
GEN_BACKEND=openai

# OpenAI 兼容接口（可换成 deepseek/通义/glm 等，只需改 BASE_URL 与 MODEL）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Messages 接口（可换成兼容网关）
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ===== 图库 =====
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# 图片来源：auto（汽车内容自动走汽车之家，其余走图库）/ autohome / pexels / unsplash
IMAGE_SOURCE=auto
# 汽车之家抓取分类（逗号分隔，可选：外观/内饰/座椅/细节）
CAR_IMAGE_CATEGORIES=外观,内饰

# ===== 小红书 MCP =====
XHS_MCP_URL=http://localhost:18060/mcp

# 静默启动浏览器：true 无头（不显示窗口）/ false 非无头（显示窗口，便于排查）
MCP_HEADLESS=true

# 默认可见范围：公开可见 / 仅自己可见 / 仅互关好友可见
XHS_VISIBILITY=公开可见

# ===== 生成规则 =====
# 自定义提示词文件（不存在时用内置默认，可在界面「配置-提示词」编辑）
PROMPT_FILE=prompts/note_prompt.txt
# 每次配图数量范围（随机取值）
IMAGE_COUNT_MIN=3
IMAGE_COUNT_MAX=4
# 正文目标字数上限（提示词用；XHS 硬上限仍为 1000）
CONTENT_TARGET_MAX=450
# 话题标签数量上限
TAGS_MAX=4
# 与最近 N 天内容的相似度阈值（0-1），超过则重新生成
DEDUP_DAYS=7
DEDUP_THRESHOLD=0.3
DEDUP_MAX_RETRY=3
# 是否抓取小红书真实笔记标题作为热点参考（上游 search_feeds 近期不稳定，默认关闭）
XHS_REFERENCE_ENABLED=false
XHS_REFERENCE_COUNT=5

# ===== 全自动发布 =====
# 发布时段（HH:MM，多个用英文逗号）
AUTO_TIMES=09:30,15:00
# 每日发布上限
AUTO_DAILY_LIMIT=2
# 自动发布的可见范围：公开可见 / 仅自己可见 / 仅互关好友可见
AUTO_VISIBILITY=公开可见
# 选题来源：pool_first 选题池优先 / ai 纯AI生成 / pool_only 仅用选题池
AUTO_TOPIC_SOURCE=pool_first
# AI 选题的领域
AUTO_DOMAIN=30岁职场人的真实职场见闻
# AI 每次生成的候选选题数
AUTO_AI_TOPIC_COUNT=5
# 常驻循环检查间隔（秒）
AUTO_CHECK_INTERVAL_SEC=60

# ===== 界面 =====
# 深/浅主题：dark / light / system
UI_APPEARANCE=dark

# ===== 新闻采集（插件式，sites/ 目录自动注册）=====
NEWS_SITE=yahoo_hk_finance
# 每次抓取数量范围（随机取值，绝不取列表前几条）
NEWS_PICK_MIN=3
NEWS_PICK_MAX=5
# AI 相关优先：true 时只在 AI 候选里随机；false 时全量随机
NEWS_AI_FIRST=true
NEWS_SELECT_MODE=random
# 列表页最多取多少条候选
NEWS_MAX_CANDIDATES=60
# 正文最多保留多少张图（下载压缩为 JPEG）
NEWS_MAX_IMAGES=10
NEWS_IMAGE_MAX_KB=500
NEWS_IMAGE_MAX_SIDE=1440
# AI 相关关键词（命中标题即算 AI 相关；繁简都列上）
NEWS_AI_KEYWORDS=AI,人工智能,大模型,生成式,DeepSeek,OpenAI,ChatGPT,英偉達,英伟达,NVIDIA,算力,晶片,芯片,機械人,机器人
# 杂质文本过滤（正则，逗号分隔：命中处起截断，去掉来源/推广尾巴）
NEWS_STRIP_PATTERNS=網址[:：],www\.,免責聲明,風險提示,以上內容,僅供參考,下載.*APP,更多精彩,關注我們,掃碼,阿思達克財經
# 整段丢弃：被 <em> 包裹的段落（作者署名/推广）直接删
NEWS_DROP_EMPHASIS=true
# 整段丢弃：命中关键词的段落直接删（订阅/推广/免责等）
NEWS_DROP_KEYWORDS=訂閱,订阅,通訊,通讯,點擊這裡,点击这里,請點擊,请点击,免費,免费,關注我們,关注我们,掃碼,扫码,下載,下载,更多精彩,newsletter,subscribe,免責,免责
# 尾部短署名启发式：删除末尾无标点且不超过 N 字的中文短段；0 关闭
NEWS_BYLINE_MAX_CHARS=6
# 正文无图时自动补充的配图数量范围（均匀插在段落之间）
NEWS_AUTO_IMAGE_MIN=3
NEWS_AUTO_IMAGE_MAX=5
# 图库完全无命中时，正文配图最多生成几张（0=关闭生成）
NEWS_AUTO_IMAGE_GEN_MAX=2

# ===== MiniMax 繁转简 =====
MINIMAX_API_KEY=
# 国内站 https://api.minimaxi.com/v1 / 国际站 https://api.minimax.io/v1
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.1
# 封面文生图模型（留空则关闭 AI 封面，回退默认封面）
MINIMAX_IMAGE_MODEL=image-01
# 单张文生图超时秒数
MINIMAX_IMAGE_TIMEOUT=60
TRANSLATE_ENABLED=true
TRANSLATE_CHUNK_CHARS=1200

# ===== 微信公众号发布（Wechatsync）=====
# 需先装 Chrome 扩展并启用「同步桥接」，填入扩展里的 Token
WECHATSYNC_CLI=wechatsync
WECHATSYNC_TOKEN=
WECHATSYNC_PLATFORMS=weixin
# 等待 Chrome 扩展连接的毫秒数
WECHATSYNC_TIMEOUT_MS=120000
# 单次同步子进程最长等待秒数
WECHATSYNC_RUN_TIMEOUT_SEC=600
SYNC_WS_PORT=9527
# 封面兜底图（本地路径，可空）；正文/补图与关键词都拿不到时使用，仍无则无封面发布
WECHAT_DEFAULT_COVER=
# 生成封面的比例：1:1 / 16:9 / 4:3 / 3:2 / 2:3 / 3:4 / 9:16 / 21:9
WECHAT_COVER_ASPECT=16:9
